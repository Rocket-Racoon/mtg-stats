# Copy to .env (gitignored). One .env at the repo root; S-1.3.3 extends this file.

# --- Docker Compose (infra) ---
# Postgres superuser name for the local container.
POSTGRES_USER=mtg_stats
# Postgres password; CHANGE_ME works as a literal local password, never reuse it elsewhere.
POSTGRES_PASSWORD=CHANGE_ME
# Dev database, created by the image on first start (mtg_stats_test is created by the init SQL).
POSTGRES_DB=mtg_stats

# --- API and worker ---
# Runtime profile: dev, test or prod. The root .env is read only when this is dev.
APP_ENV=dev
# Async SQLAlchemy URL; must use the postgresql+psycopg:// driver (matches the Compose group above).
DATABASE_URL=postgresql+psycopg://mtg_stats:CHANGE_ME@localhost:5432/mtg_stats
# Comma-separated browser origins allowed by CORS; no wildcard. Dev always adds http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173
