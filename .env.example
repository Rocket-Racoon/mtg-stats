# Copy to .env (gitignored). One .env at the repo root; S-1.3.3 extends this file.

# --- Docker Compose (infra) ---
# Postgres superuser name for the local container.
POSTGRES_USER=mtg_stats
# Postgres password; local dev-only default, never reuse it elsewhere.
POSTGRES_PASSWORD=mtg_stats_dev
# Dev database, created by the image on first start (mtg_stats_test is created by the init script).
POSTGRES_DB=mtg_stats
# Host port for Postgres (bound to 127.0.0.1 only).
POSTGRES_PORT=5432
# Host port for Redis (bound to 127.0.0.1 only).
REDIS_PORT=6379
