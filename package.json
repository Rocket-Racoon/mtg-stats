{
  "name": "mtg-stats",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.1.3 <12"
  },
  "scripts": {
    "lint": "pnpm -r lint && eslint tests eslint.config.js",
    "format": "pnpm -r format && prettier --write --ignore-unknown --no-error-on-unmatched-pattern --ignore-path .prettierignore \"*.{json,js,yaml}\" \"infra/**/*.{yml,yaml}\" \".github/**/*.{yml,yaml}\" \"scripts/**/*.{js,ts,json}\" \"tests/**/*.ts\"",
    "format:check": "pnpm -r format:check && prettier --check --ignore-unknown --no-error-on-unmatched-pattern --ignore-path .prettierignore \"*.{json,js,yaml}\" \"infra/**/*.{yml,yaml}\" \".github/**/*.{yml,yaml}\" \"scripts/**/*.{js,ts,json}\" \"tests/**/*.ts\"",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "openapi:export": "uv run --directory apps/api python -m app.scripts.export_openapi",
    "hooks:install": "uv run --project apps/api pre-commit install",
    "secrets:check": "uv run --project apps/api python scripts/secrets_check.py",
    "test": "pnpm -r test && vitest run --dir tests"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
