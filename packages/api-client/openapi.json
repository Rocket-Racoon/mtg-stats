{
  "components": {
    "schemas": {
      "ErrorBody": {
        "description": "The ``error`` object of every error response.",
        "properties": {
          "code": {
            "description": "Stable snake_case code; clients switch on this.",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Extra structured information, or null.",
            "title": "Details"
          },
          "message": {
            "description": "Human-readable text; never switch on it.",
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "description": "Matches the X-Request-ID header and the logs.",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Envelope of every error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "LiveResponse": {
        "description": "Body of ``GET /health/live``.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LiveResponse",
        "type": "object"
      },
      "LoginRequest": {
        "description": "Credentials. Only bounds are checked here; registration rules do not apply to sign-in.",
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ReadyChecks": {
        "description": "Result of each dependency check.",
        "properties": {
          "database": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database",
            "type": "string"
          },
          "redis": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Redis",
            "type": "string"
          }
        },
        "required": [
          "database",
          "redis"
        ],
        "title": "ReadyChecks",
        "type": "object"
      },
      "ReadyResponse": {
        "description": "Body of ``GET /health/ready``: 200 when every check is ok, 503 otherwise (same shape).",
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadyChecks"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Build version: the git SHA, or \"dev\" locally.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks",
          "version"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "TokenResponse": {
        "description": "Tokens issued by a successful sign-in.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Access token lifetime in seconds.",
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "token_type",
          "expires_in"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "ValidationDetails": {
        "description": "``details`` of a ``validation_error``.",
        "properties": {
          "fields": {
            "items": {
              "$ref": "#/components/schemas/ValidationField"
            },
            "title": "Fields",
            "type": "array"
          }
        },
        "required": [
          "fields"
        ],
        "title": "ValidationDetails",
        "type": "object"
      },
      "ValidationErrorBody": {
        "description": "Error body of a 422 ``validation_error``.",
        "properties": {
          "code": {
            "description": "Stable snake_case code; clients switch on this.",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "$ref": "#/components/schemas/ValidationDetails"
          },
          "message": {
            "description": "Human-readable text; never switch on it.",
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "description": "Matches the X-Request-ID header and the logs.",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "request_id"
        ],
        "title": "ValidationErrorBody",
        "type": "object"
      },
      "ValidationErrorResponse": {
        "description": "Envelope of a 422 response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ValidationErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ValidationErrorResponse",
        "type": "object"
      },
      "ValidationField": {
        "description": "One failing field of a request.",
        "properties": {
          "loc": {
            "description": "Raw location, including the leading body/query/path/header part.",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "description": "Dotted form of loc, for display.",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "path",
          "message"
        ],
        "title": "ValidationField",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "MTG Stats API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "Exchange a username and password for an access token and a refresh token.\n\nUnknown user, wrong password and inactive account all return the same 401\n(``invalid_credentials``).",
        "operationId": "identity_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Client error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Server error"
          }
        },
        "summary": "Sign in",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "description": "Return 200 while the process runs; contacts no dependency.",
        "operationId": "system_live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
