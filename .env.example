# Copy to .env (gitignored). One .env at the repo root.
# Every value is a safe local default or CHANGE_ME. Never commit real secrets (scripts/secrets_check.py).

# --- Docker Compose (infra) ---
# Postgres superuser name for the local container.
POSTGRES_USER=mtg_stats
# Postgres password; CHANGE_ME works as a literal local password, never reuse it elsewhere.
POSTGRES_PASSWORD=CHANGE_ME
# Dev database, created by the image on first start (mtg_stats_test is created by the init SQL).
POSTGRES_DB=mtg_stats
# POSTGRES_PORT and REDIS_PORT overrides are shell-only, not read from this file (see the infra/docker-compose.yml header).

# --- API and worker ---
# Read by apps/api (FastAPI) and the arq worker.
# Runtime profile: dev, test or prod. The root .env is read only when this is dev.
APP_ENV=dev
# Async SQLAlchemy URL; must use the postgresql+psycopg:// driver (matches the Compose group above).
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and can hang, as Compose binds 127.0.0.1 only.
DATABASE_URL=postgresql+psycopg://mtg_stats:CHANGE_ME@127.0.0.1:5432/mtg_stats
# Seconds to wait when opening a database connection (default 5).
DB_CONNECT_TIMEOUT=5
# Redis URL for the health check and jobs (use 127.0.0.1, as above).
REDIS_URL=redis://127.0.0.1:6379/0
# Name of the arq job queue shared by the API (enqueue) and the worker (default arq:queue).
WORKER_QUEUE_NAME=arq:queue
# Seconds the worker waits for running jobs to finish on SIGTERM/Ctrl+C (default 30).
WORKER_SHUTDOWN_GRACE_SECONDS=30
# Values above about 40 also need stop_grace_period of the worker in infra/docker-compose.yml raised, or Docker kills running jobs.
# Run scheduled (cron) jobs in the worker (default true). Never runs when APP_ENV=test.
SCHEDULER_ENABLED=true
# Build version reported by /health/ready (git SHA set by CI/deploy; "dev" locally).
GIT_SHA=dev
# Comma-separated browser origins allowed by CORS; no wildcard. Dev always adds http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Log level for API and worker JSON logs: DEBUG, INFO, WARNING, ERROR or CRITICAL (default INFO).
LOG_LEVEL=INFO
# Base URL of the web app, used by public_link() to build shareable links. Required; must be https:// when APP_ENV=prod.
PUBLIC_WEB_URL=http://localhost:5173
# Secret that signs access and refresh tokens (HS256). Required, at least 32 characters, never commit a real one.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-jwt-secret-change-me-before-any-real-deployment # secrets-check: allow
# Access token lifetime in minutes (default 15, 1 to 1440).
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token lifetime in days (default 30, 1 to 365).
REFRESH_TOKEN_TTL_DAYS=30
# Argon2id password hashing cost (S-2.1.1). Time cost in passes (default 3).
ARGON2_TIME_COST=3
# Memory cost in KiB (default 65536 = 64 MiB); must be at least 8 x ARGON2_PARALLELISM.
ARGON2_MEMORY_COST=65536
# Lanes (default 4). Changing these only affects new hashes; old ones are flagged for rehash.
ARGON2_PARALLELISM=4

# --- Web (Vite) ---
# Read by apps/web; only VITE_-prefixed names reach the browser, so never put secrets here.
# API base URL the web app calls; required by `vite build`, dev/test fall back to this value.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Mobile (Expo) ---
# Read by apps/mobile; only EXPO_PUBLIC_-prefixed names reach the app, so never put secrets here.
# Required: the app shows a configuration error screen when this is missing or not an http(s) URL.
# apps/mobile/app.config.ts copies it from this root file for the development profile only (preview
# and production builds take it from the build's own environment); a value set in the shell or in
# apps/mobile/.env wins. Restart Expo with --clear after changing it (it is inlined).
# On a physical phone use the dev machine's LAN IP (localhost is the phone itself), and start the
# API with `pnpm dev:api:lan`. Android emulator: use 10.0.2.2 as the host. See README "Test on a phone".
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
