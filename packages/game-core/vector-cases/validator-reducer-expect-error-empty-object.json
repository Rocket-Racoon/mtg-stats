{
  "format": 1,
  "kind": "validator",
  "name": "validator-reducer-expect-error-empty-object",
  "rule": "8.3 expect.error",
  "description": "An empty error object lacks index and code: both required messages, index first.",
  "file": "vec.json",
  "text": "{\"kind\":\"reducer\",\"format\":1,\"name\":\"vec\",\"description\":\"d\",\"game_id\":\"g\",\"settings\":{},\"events\":[{\"event_id\":\"e1\",\"type\":\"turn_passed\",\"payload\":{},\"v\":1},{\"event_id\":\"e1\",\"type\":\"turn_passed\",\"payload\":{},\"v\":1}],\"expect\":{\"error\":{}}}",
  "messages": [
    "vec.json: expect.error.index is required",
    "vec.json: expect.error.code is required"
  ]
}
