{
  "name": "mtg-stats",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.1.3 <12"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "format": "pnpm -r format && prettier --write --ignore-path .prettierignore \"*.{json,js,yaml}\"",
    "format:check": "pnpm -r format:check && prettier --check --ignore-path .prettierignore \"*.{json,js,yaml}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
