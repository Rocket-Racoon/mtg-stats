{
  "format": 1,
  "kind": "coverage",
  "name": "coverage-vector-that-fails-validation-does-not-count",
  "rule": "8.4",
  "description": "v2 has a wrong name, so it fails validation and covers nothing, whatever it applies.",
  "registry": ["alpha", "beta"],
  "files": [
    {
      "file": "v1.json",
      "text": "{\"kind\":\"reducer\",\"format\":1,\"name\":\"v1\",\"description\":\"d\",\"game_id\":\"g\",\"settings\":{},\"events\":[{\"type\":\"alpha\",\"payload\":{}}],\"expect\":{\"state\":{}}}"
    },
    {
      "file": "v2.json",
      "text": "{\"kind\":\"reducer\",\"format\":1,\"name\":\"other\",\"description\":\"d\",\"game_id\":\"g\",\"settings\":{},\"events\":[{\"type\":\"beta\"}],\"expect\":{\"state\":{}}}"
    }
  ],
  "messages": ["uncovered event type: beta"]
}
